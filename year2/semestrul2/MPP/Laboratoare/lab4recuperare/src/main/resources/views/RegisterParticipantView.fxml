<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<GridPane alignment="center" hgap="10" vgap="10" xmlns:fx="http://javafx.com/fxml/1"
          xmlns="http://javafx.com/javafx/17.0.12"
          fx:controller="org.example.Controller.RegisterController"
          stylesheets="@/views/stylelogin.css">

    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>
    

    <Label text="Name:" GridPane.rowIndex="1" />
    <TextField fx:id="nameField" GridPane.columnIndex="1" GridPane.rowIndex="1" />

    <Label text="Surname:" GridPane.rowIndex="2" />
    <TextField fx:id="surnameField" GridPane.columnIndex="1" GridPane.rowIndex="2" />

    <Label text="Age:" GridPane.rowIndex="3" />
    <TextField fx:id="ageField" GridPane.columnIndex="1" GridPane.rowIndex="3" />

    <Label text="Email:" GridPane.rowIndex="4" />
    <TextField fx:id="emailField" GridPane.columnIndex="1" GridPane.rowIndex="4" />

    <Button onAction="#handleRegisterButtonAction" prefHeight="26.0" prefWidth="86.0" text="Register" GridPane.columnIndex="1" GridPane.rowIndex="5" />
    <Button text="Manage Inscrieri"
            layoutX="10" layoutY="250"
            onAction="#handleOpenInscriereWindow"/>

    <columnConstraints>
      <ColumnConstraints />
      <ColumnConstraints />
   </columnConstraints>
   <rowConstraints>
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
   </rowConstraints>
</GridPane>
