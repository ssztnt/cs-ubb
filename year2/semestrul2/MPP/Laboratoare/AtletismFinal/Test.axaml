<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AtletismFinal.TestWindow"
        Title="Test Controls"
        Width="400" Height="300"
        Background="White">

    <StackPanel Margin="20" Spacing="10">

        <TextBlock Text="Test CheckBoxes" FontSize="16" />

        <CheckBox Content="Option A" IsChecked="True"/>
        <CheckBox Content="Option B"/>
        <CheckBox Content="Option C"/>

        <TextBlock Text="Choose something:" Margin="0 20 0 0" />
        <ComboBox>
            <ComboBoxItem Content="One" />
            <ComboBoxItem Content="Two" />
            <ComboBoxItem Content="Three" />
        </ComboBox>

    </StackPanel>
</Window>