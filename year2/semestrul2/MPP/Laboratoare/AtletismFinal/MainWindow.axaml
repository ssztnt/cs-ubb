<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="https://github.com/avaloniaui/designer"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        x:Class="AtletismFinal.MainWindow"
        Title="Register Participant"
        Width="450" Height="320"
        Background="White">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
          ColumnDefinitions="Auto, *"
          Margin="20"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">

        <TextBlock Grid.ColumnSpan="2" Text="Register Participant"
                   FontSize="20" Margin="0 0 0 15"
                   HorizontalAlignment="Center"/>

        <TextBlock Text="Nume:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox x:Name="NumeBox" Grid.Row="1" Grid.Column="1" Width="250" />

        <TextBlock Text="Prenume:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox x:Name="PrenumeBox" Grid.Row="2" Grid.Column="1" Width="250" />

        <TextBlock Text="Varsta:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox x:Name="VarstaBox" Grid.Row="3" Grid.Column="1" Width="250" />

        <TextBlock Text="Email:" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox x:Name="EmailBox" Grid.Row="4" Grid.Column="1" Width="250" />

        <Button Grid.Row="5" Grid.ColumnSpan="2" Content="Register"
                Click="OnRegisterClicked"
                HorizontalAlignment="Center" Margin="0 15 0 0" Width="120"/>

        <TextBlock x:Name="StatusText" Grid.Row="6" Grid.ColumnSpan="2"
                   HorizontalAlignment="Center"
                   Foreground="Green" Margin="0 10 0 0"/>
    </Grid>
</Window>